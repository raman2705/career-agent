# Proposed settings for future implementation; nothing loads this file yet.
# Copy to .env for local use. Never put real secrets in this example file.

# Path to a local Google credentials file, e.g. credentials/google-service-account.json.
GOOGLE_APPLICATION_CREDENTIALS=

# Destination spreadsheet identifier (not the full URL).
GOOGLE_SHEETS_SPREADSHEET_ID=

# Path to local candidate preferences, e.g. personal_data/preferences.json.
CANDIDATE_PREFERENCES_PATH=
